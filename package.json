{
  "name": "@forge-ahead/atlassian-api-types",
  "version": "0.1.1",
  "description": "TypeScript types for Atlassian APIs, generated from OpenAPI specifications, optimized for Forge apps.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibuchanan/forge-ahead-atlassian-api-types.git"
  },
  "homepage": "https://github.com/ibuchanan/forge-ahead-atlassian-api-types#readme",
  "private": true,
  "license": "Apache-2.0",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    },
    "./api-access": {
      "import": "./dist/api-access.mjs",
      "types": "./dist/api-access.d.ts"
    },
    "./assets": {
      "import": "./dist/assets.mjs",
      "types": "./dist/assets.d.ts"
    },
    "./bitbucket": {
      "import": "./dist/bitbucket.mjs",
      "types": "./dist/bitbucket.d.ts"
    },
    "./confluence-1": {
      "import": "./dist/confluence-1.mjs",
      "types": "./dist/confluence-1.d.ts"
    },
    "./confluence-2": {
      "import": "./dist/confluence-2.mjs",
      "types": "./dist/confluence-2.d.ts"
    },
    "./jira-platform-2": {
      "import": "./dist/jira-platform-2.mjs",
      "types": "./dist/jira-platform-2.d.ts"
    },
    "./jira-platform-3": {
      "import": "./dist/jira-platform-3.mjs",
      "types": "./dist/jira-platform-3.d.ts"
    },
    "./jira-software": {
      "import": "./dist/jira-software.mjs",
      "types": "./dist/jira-software.d.ts"
    }
  },
  "main": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "api-access": [
        "dist/api-access.d.ts"
      ],
      "assets": [
        "dist/assets.d.ts"
      ],
      "bitbucket": [
        "dist/bitbucket.d.ts"
      ],
      "confluence-1": [
        "dist/confluence-1.d.ts"
      ],
      "confluence-2": [
        "dist/confluence-2.d.ts"
      ],
      "jira-platform-2": [
        "dist/jira-platform-2.d.ts"
      ],
      "jira-platform-3": [
        "dist/jira-platform-3.d.ts"
      ],
      "jira-software": [
        "dist/jira-software.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "changelog": "touch CHANGELOG.md && git cliff --offline --unreleased --prepend CHANGELOG.md",
    "check": "npm run typecheck",
    "clean": "rm -rf ./node_modules && rm package-lock.json && rm -rf ./dist",
    "dev": "tsdown --watch",
    "generate": "openapi-typescript",
    "lint": "npm run lint:openapi",
    "lint:openapi": "node ./scripts/lint-openapi-with-vacuum.mjs",
    "prepare": "npm run build",
    "release:prepare": "scripts/release-prepare.sh",
    "test": "npm run lint:openapi",
    "typecheck": "tsc --noEmit"
  },
  "overrides": {
    "rolldown-plugin-dts": {
      "yuku-parser": "0.6.3"
    }
  },
  "devDependencies": {
    "@quobix/vacuum": "^0.29",
    "openapi-typescript": "^7.13",
    "tsdown": "^0.22",
    "typescript": "^5.9"
  }
}
