{
  "name": "@forge-ahead/atlassian-api-types",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./api-access": {
      "import": "./dist/api-access.mjs",
      "types": "./dist/api-access.d.mts"
    },
    "./assets": {
      "import": "./dist/assets.mjs",
      "types": "./dist/assets.d.mts"
    },
    "./bitbucket": {
      "import": "./dist/bitbucket.mjs",
      "types": "./dist/bitbucket.d.mts"
    },
    "./confluence-1": {
      "import": "./dist/confluence-1.mjs",
      "types": "./dist/confluence-1.d.mts"
    },
    "./confluence-2": {
      "import": "./dist/confluence-2.mjs",
      "types": "./dist/confluence-2.d.mts"
    },
    "./jira-platform-2": {
      "import": "./dist/jira-platform-2.mjs",
      "types": "./dist/jira-platform-2.d.mts"
    },
    "./jira-platform-3": {
      "import": "./dist/jira-platform-3.mjs",
      "types": "./dist/jira-platform-3.d.mts"
    },
    "./jira-software": {
      "import": "./dist/jira-software.mjs",
      "types": "./dist/jira-software.d.mts"
    }
  },
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "npm run lint:openapi && npm run typecheck && npm run build",
    "clean": "rm -rf ./node_modules && rm package-lock.json && rm -rf ./dist",
    "generate": "openapi-typescript",
    "lint": "npm run lint:openapi",
    "lint:openapi": "node ./scripts/lint-openapi-with-vacuum.mjs",
    "prepare": "npm run build",
    "test": "npm run lint:openapi",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@quobix/vacuum": "0.29.9",
    "openapi-typescript": "7.13.0",
    "tsdown": "0.22.3",
    "typescript": "5.9.3"
  }
}
